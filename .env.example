# Copied to .env by `make setup`. These are development defaults only.
# DJANGO_SETTINGS_MODULE is deliberately NOT set here: manage.py defaults to
# development settings and pytest forces the test settings.
COMPOSE_PROJECT_NAME=sololedger

DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=sololedger
POSTGRES_USER=sololedger
POSTGRES_PASSWORD=sololedger
POSTGRES_HOST=db
POSTGRES_PORT=5432
